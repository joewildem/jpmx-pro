---
import ProjectPage from '../../components/ProjectPage.astro';
import { getPublishedProjects } from '../../lib/content';
export async function getStaticPaths() {
  const projects = await getPublishedProjects('es');
  return projects.map((project) => ({ params: { slug: project.projectSlug }, props: { project } }));
}
const { project } = Astro.props;
const projects = await getPublishedProjects('es');
const related = projects.find((item) => item.projectSlug === project.relatedSlug);
---
<ProjectPage project={project} related={related} />
