---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectMarquee from './ProjectMarquee.astro';
import StatsMarquee from './StatsMarquee.astro';
import HugeIcon from './HugeIcon.astro';
import { ArrowUpRight01Icon } from '@hugeicons/core-free-icons';
import type { CollectionEntry } from 'astro:content';
type Home = CollectionEntry<'pages'>['data'];
type Project = CollectionEntry<'projects'>['data'];
interface Props { page: Home; projects: Project[]; }
const { page, projects } = Astro.props;
const locale = page.locale;
const heroTitleParts = page.heroTitle.split(/,\s+(?=Senior Product Designer$)/);
const heroTitleLead = heroTitleParts.length === 2 ? `${heroTitleParts[0]},` : page.heroTitle;
const heroTitleRole = heroTitleParts.length === 2 ? heroTitleParts[1] : '';
const heroName = 'Joe Palomino';
const heroNameIndex = heroTitleLead.indexOf(heroName);
const heroTitleBeforeName = heroNameIndex >= 0 ? heroTitleLead.slice(0, heroNameIndex) : heroTitleLead;
const heroTitleAfterName = heroNameIndex >= 0 ? heroTitleLead.slice(heroNameIndex + heroName.length) : '';
---
<BaseLayout title={page.seoTitle} description={page.seoDescription} locale={locale} path={locale === 'es' ? '/' : '/en/'}>
  <div id="top"></div>
  <Header locale={locale} />
  <main>
    <div class="hero-viewport">
      <div class="hero-meta"><div class="container"><span>{page.location}</span><span class="availability availability--meta">{page.availability}</span></div></div>
      <section class="hero">
        <div class="hero-content container" data-reveal>
          <p class="availability availability--hero">{page.availability}</p>
          <h1>
            <span>{heroTitleBeforeName}{heroNameIndex >= 0 && <span class="hero-name">{heroName}</span>}{heroTitleAfterName}</span>
            {heroTitleRole && <span>{heroTitleRole}</span>}
          </h1>
          <p class="hero-description">{page.heroDescription}</p>
          <div class="button-row"><a class="button button--secondary" href="#projects">{page.primaryCta}</a><a class="button button--primary" href="mailto:hello@jpmx.pro">{page.contactCta}</a></div>
        </div>
      </section>
      <div class="now-bar">
        <div class="container">
          <div class="now-status">
            <span class="now-label">{page.nowLabel}</span>
            <span class="now-activity-window" aria-live="polite">
              <span class="now-activity-track" data-activity-rotator>
                {[...page.nowItems, page.nowItems[0]].map((item) => <span class="now-activity">{item}</span>)}
              </span>
            </span>
          </div>
          <div class="scroll-cue" aria-label={`${page.scrollCueStart} ${page.scrollCueEnd}`}>
            <span class="scroll-cue-start">{page.scrollCueStart}</span>
            <span class="scroll-cue-lottie" data-scroll-lottie aria-hidden="true"></span>
            <span class="scroll-cue-end">{page.scrollCueEnd}</span>
          </div>
        </div>
      </div>
    </div>
    <section class="section projects-section" id="projects">
      <ProjectMarquee label={page.projectsLabel} />
      <div class="container projects-list">
        <div class="project-grid">{projects.map((project) => <ProjectCard project={project} locale={locale} />)}</div>
        <div class="projects-more"><a class="button button--secondary" href="https://www.linkedin.com/in/joepalominoux/" target="_blank" rel="noreferrer">{locale === 'es' ? 'Ver más proyectos' : 'See more work'}</a></div>
      </div>
    </section>
    <section class="services-section" id="services">
      <div class="container services-shell">
        <div class="services-heading">
          <div class="services-intro" data-reveal>
            <h2>{page.servicesTitle}</h2>
            <p>{page.servicesDescription}</p>
            <a class="button button--secondary services-cta" href="mailto:hello@jpmx.pro">
              {locale === 'es' ? 'Hablemos' : 'Get in touch'}
              <HugeIcon icon={ArrowUpRight01Icon} size={18} />
            </a>
          </div>
        </div>
        <div class="services-list">
          {page.services.map((service, index) => (
            <article class="service" aria-labelledby={`service-${index}`} data-reveal>
              <h3 id={`service-${index}`}>{service.title}</h3>
              <ul class="skills">
                {service.skills.map((skill, skillIndex) => (
                  <li>
                    <span class="skill-index">{String(skillIndex + 1).padStart(2, '0')}</span>
                    <span class="skill-name">{skill}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
    <StatsMarquee stats={page.stats} />
  </main>
  <Footer locale={locale} />
</BaseLayout>

<script>
  import lottie from 'lottie-web/build/player/lottie_light';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-activity-rotator]').forEach((track) => {
    const itemCount = track.children.length - 1;
    if (reduceMotion || itemCount < 2) return;

    let index = 0;
    const moveToItem = () => {
      const item = track.firstElementChild;
      if (!(item instanceof HTMLElement)) return;
      track.style.transform = `translateY(${-index * item.offsetHeight}px)`;
    };

    const showNextItem = () => {
      window.setTimeout(() => {
        index += 1;
        moveToItem();

        window.setTimeout(() => {
          if (index !== itemCount) {
            showNextItem();
            return;
          }

          track.classList.add('is-resetting');
          index = 0;
          moveToItem();
          requestAnimationFrame(() => requestAnimationFrame(() => track.classList.remove('is-resetting')));
          showNextItem();
        }, 650);
      }, 4500);
    };

    window.addEventListener('resize', moveToItem);
    showNextItem();
  });

  document.querySelectorAll<HTMLElement>('[data-scroll-lottie]').forEach((container) => {
    lottie.loadAnimation({
      container,
      renderer: 'svg',
      loop: !reduceMotion,
      autoplay: !reduceMotion,
      path: 'https://lottie.host/e35b105d-0108-437c-ad52-93e7d1d57e6f/r6YwDko1EG.json',
      rendererSettings: { preserveAspectRatio: 'xMidYMid meet' },
    });
  });
</script>
