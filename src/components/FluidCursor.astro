<canvas class="fluid-cursor" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.fluid-cursor');
  const precisePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const interactiveSelector =
    'a, button, input, select, textarea, label, [role="button"], [data-cursor="clickable"], [tabindex]:not([tabindex="-1"])';

  if (canvas && !reducedMotion.matches) {
    type Simulation = import('../lib/fluid/FluidSimulation').FluidSimulation;
    type TouchGesture = { identifier: number; x: number; y: number; startedAt: number; moved: boolean };

    let simulation: Simulation | null = null;
    let simulationPromise: Promise<Simulation | null> | null = null;
    let touchGesture: TouchGesture | null = null;
    let lastTouchEnd = 0;

    const isInteractive = (target: EventTarget | null) =>
      target instanceof Element && Boolean(target.closest(interactiveSelector));

    const loadSimulation = () => {
      simulationPromise ??= import('../lib/fluid/FluidSimulation')
        .then(({ FluidSimulation }) => {
          simulation = new FluidSimulation(canvas, {
            performanceProfile: precisePointer.matches ? 'default' : 'touch',
          });
          return simulation;
        })
        .catch((error) => {
          canvas.remove();
          console.warn('The fluid cursor is not supported on this device.', error);
          return null;
        });

      return simulationPromise;
    };

    const pointerMove = (event: PointerEvent) => {
      if (event.pointerType && event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
      simulation?.move(event.clientX, event.clientY);
    };

    const findTouch = (touches: TouchList, identifier: number) => {
      for (let index = 0; index < touches.length; index += 1) {
        const touch = touches.item(index);
        if (touch?.identifier === identifier) return touch;
      }

      return null;
    };

    const touchStart = (event: TouchEvent) => {
      touchGesture = null;
      if (event.touches.length !== 1 || isInteractive(event.target)) return;

      const touch = event.changedTouches.item(0);
      if (!touch) return;

      touchGesture = {
        identifier: touch.identifier,
        x: touch.clientX,
        y: touch.clientY,
        startedAt: performance.now(),
        moved: false,
      };

      const identifier = touch.identifier;
      const x = touch.clientX;
      const y = touch.clientY;
      void loadSimulation().then((activeSimulation) => {
        if (touchGesture?.identifier !== identifier) return;
        activeSimulation?.resetPointer();
        activeSimulation?.move(x, y);
      });
    };

    const touchMove = (event: TouchEvent) => {
      if (!touchGesture) return;

      const touch = findTouch(event.touches, touchGesture.identifier);
      if (!touch) return;

      if (Math.hypot(touch.clientX - touchGesture.x, touch.clientY - touchGesture.y) > 12) {
        touchGesture.moved = true;
      }

      const identifier = touchGesture.identifier;
      const x = touch.clientX;
      const y = touch.clientY;
      void loadSimulation().then((activeSimulation) => {
        if (touchGesture?.identifier !== identifier) return;
        activeSimulation?.move(x, y);
      });
    };

    const touchEnd = (event: TouchEvent) => {
      if (!touchGesture) return;

      const touch = findTouch(event.changedTouches, touchGesture.identifier);
      if (!touch) return;

      const gesture = touchGesture;
      touchGesture = null;
      lastTouchEnd = performance.now();

      const moved = Math.hypot(touch.clientX - gesture.x, touch.clientY - gesture.y);
      const elapsed = lastTouchEnd - gesture.startedAt;
      if (gesture.moved || moved > 12 || elapsed > 700 || isInteractive(event.target)) {
        simulation?.resetPointer();
        return;
      }

      void loadSimulation().then((activeSimulation) => {
        activeSimulation?.splatAt(touch.clientX, touch.clientY);
      });
    };

    const click = (event: MouseEvent) => {
      if (!precisePointer.matches || performance.now() - lastTouchEnd < 800 || isInteractive(event.target)) return;

      void loadSimulation().then((activeSimulation) => {
        activeSimulation?.splatAt(event.clientX, event.clientY);
      });
    };

    const cancelTouch = () => {
      touchGesture = null;
      simulation?.resetPointer();
    };
    const visibility = () => (document.hidden ? simulation?.stop() : simulation?.start());

    window.addEventListener('pointermove', pointerMove, { passive: true });
    window.addEventListener('touchstart', touchStart, { passive: true });
    window.addEventListener('touchmove', touchMove, { passive: true });
    window.addEventListener('touchend', touchEnd, { passive: true });
    window.addEventListener('touchcancel', cancelTouch, { passive: true });
    window.addEventListener('click', click, { passive: true });
    window.addEventListener('resize', () => simulation?.resize(), { passive: true });
    window.addEventListener('blur', () => {
      touchGesture = null;
      simulation?.resetPointer();
    });
    document.documentElement.addEventListener('mouseleave', () => simulation?.resetPointer());
    document.addEventListener('visibilitychange', visibility);

    if (precisePointer.matches) void loadSimulation();
  }
</script>
