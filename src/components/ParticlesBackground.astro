<div id="site-particles" class="site-particles" aria-hidden="true"></div>

<script is:inline src="/vendor/particles.min.js"></script>
<script>
  import nasaConfig from '../data/particlesjs-nasa.json';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion && window.particlesJS) {
    const backgroundConfig = {
      ...nasaConfig,
      interactivity: {
        ...nasaConfig.interactivity,
        detect_on: 'window',
      },
    };

    window.particlesJS(
      'site-particles',
      backgroundConfig as unknown as Record<string, unknown>,
    );
  }
</script>
