<script>
  import { magicMouse } from 'magicmouse.js';

  const precisePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (precisePointer.matches && !reducedMotion.matches) {
    document
      .querySelectorAll<HTMLElement>('.brand, .nav a, .button, .footer-links a')
      .forEach((element) => element.classList.add('magic-hover'));

    try {
      magicMouse({
        cursorOuter: 'circle-basic',
        hoverEffect: 'circle-move',
        hoverItemMove: false,
        defaultCursor: false,
        outerWidth: 30,
        outerHeight: 30,
      });
    } catch (error) {
      document.body.style.cursor = '';
      document.getElementById('magicMouseCursor')?.remove();
      document.getElementById('magicPointer')?.remove();
      console.error('Magic Mouse could not be initialized.', error);
    }
  }
</script>
