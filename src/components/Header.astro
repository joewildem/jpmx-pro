---
interface Props { locale: 'es'|'en'; projectSlug?: string; }
const { locale, projectSlug } = Astro.props;
const home = locale === 'es' ? '/' : '/en/';
const esHref = projectSlug ? `/projects/${projectSlug}` : '/';
const enHref = projectSlug ? `/en/projects/${projectSlug}` : '/en/';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={home}>JPMX</a>
    <nav class="nav" aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
      <span class="nav-sections"><a href={`${home}#about`}>{locale === 'es' ? 'Acerca de' : 'About'}</a></span>
      <span class="nav-sections"><a href={`${home}#projects`}>{locale === 'es' ? 'Proyectos' : 'Projects'}</a></span>
      <span class="nav-sections"><a href={`${home}#services`}>{locale === 'es' ? 'Servicios' : 'Services'}</a></span>
      <span class="language">
        <a href={esHref} aria-current={locale === 'es' ? 'page' : undefined}>ES</a>
        <span aria-hidden="true">|</span>
        <a href={enHref} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      </span>
    </nav>
  </div>
</header>
